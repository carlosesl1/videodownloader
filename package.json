{
  "name": "video-radar-extension",
  "version": "1.2.0",
  "private": true,
  "description": "On-demand Chromium extension for authorized direct, HLS and public social-video downloads.",
  "license": "MIT",
  "author": "Carlos (carlosesl1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosesl1/videodownloader.git"
  },
  "bugs": {
    "url": "https://github.com/carlosesl1/videodownloader/issues"
  },
  "homepage": "https://github.com/carlosesl1/videodownloader#readme",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "video-downloader",
    "hls",
    "native-messaging"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/validate-extension.mjs && node --test test/*.test.js",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dotnet.ps1 run --project native-host/VideoRadar.NativeHost.Tests",
    "check:all": "npm run check && npm run test:native",
    "check:release": "node scripts/validate-release.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "verify:release": "node scripts/verify-release-artifacts.mjs",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  }
}
